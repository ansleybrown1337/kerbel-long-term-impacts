# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
#docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# stan models
out/*.rds

# big ML files
out/ml_catboost_conformal_loyo/imputed_row_draws.csv
/code/out_cmdstanr
.venv/
.DS_Store

# Local model/runtime artifacts
catboost_info/
**/out_cmdstanr/
**/__pycache__/
*.py[cod]
code/**/*.exe
code/**/*.dll
code/**/*.so
code/**/*.dylib

# Test and plotting caches
.pytest_cache/
Rplots.pdf

# Large Bayesian runtime outputs
# Keep fit_mogp_*.rds model objects trackable when feasible; ignore the
# very large CmdStan chain CSVs that GitHub cannot accept without LFS.
results/bayes/**/cmdstan*/*.csv
results/bayes/**/cmdstan*/**/*.csv

# Large draw-level outputs, retain compact summaries and diagnostics
results/**/annual_load_draws*.csv
results/**/event_analyte_draw_ledger*.csv
results/**/*draw*.csv
results/ml/**/imputed_row_draws.csv

# Temporary validation and scratch outputs (not scientific release products)
validation/preflight/**/bayes_preflight*.log
out/*codex*_check/
figs/*codex*_check/
out/**/scratch/
figs/**/scratch/
*.tmp
*.inspect.ndjson

# Local Codex writing/building utilities
/tools/
/tmp/
/out/docx_work
/docs/drafts
